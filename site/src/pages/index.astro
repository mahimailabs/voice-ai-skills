---
// The home page: visuals first, prose trimmed to captions. Every number on it comes from the
// repository: a real review run, the turn-taking skill's clinic case, and the latency
// calculator's README example. home.generated.json is written by scripts/sync-skills.mjs.
import StarlightPage from '@astrojs/starlight/components/StarlightPage.astro';
import { ArrowRight } from 'lucide-react';
import CallMap from '../components/CallMap';
import CopyCommand from '../components/CopyCommand';
import HeroScore from '../components/HeroScore.astro';
import LatencyBudget from '../components/LatencyBudget.astro';
import PauseDemo from '../components/PauseDemo.astro';
import home from '../data/home.generated.json';

const REPO = 'https://github.com/mahimailabs/voice-ai-skills';
// The installer asks which skills and which coding agents to install for, so one command is enough.
const install = 'npx skills add mahimailabs/voice-ai-skills';
const agents = ['Claude Code', 'Codex', 'Cursor', 'Gemini CLI', 'GitHub Copilot'];
---

<StarlightPage
  frontmatter={{
    title: 'Voice AI Skills',
    description:
      'Vendor-neutral engineering judgment for the coding agent building your voice agent. Ten skills, versioned adapters for LiveKit, Pipecat, and Vapi.',
    template: 'splash',
    editUrl: false,
    prev: false,
    next: false,
    tableOfContents: false,
  }}
  hasSidebar={false}
>
  <div class="home not-content">
    <section class="hero" aria-labelledby="hero-heading">
      <div class="hero-copy">
        <h1 id="hero-heading">Your coding agent builds voice agents like web apps.</h1>
        <p class="lede">Ten skills that teach it the decisions voice gets wrong.</p>
        <div class="hero-install">
          <CopyCommand client:visible command={install} size="lg" />
        </div>
        <ul class="agents" aria-label="Works with">
          {agents.map((a) => <li>{a}</li>)}
        </ul>
      </div>
      <HeroScore />
    </section>

    <section class="chapter" aria-labelledby="pause-heading">
      <div class="head">
        <h2 id="pause-heading">A pause is not the end of a turn.</h2>
        <p>Same caller, same date of birth. Three ways to decide they finished.</p>
      </div>
      <PauseDemo />
    </section>

    <section class="chapter split" aria-labelledby="lat-heading">
      <div class="head">
        <h2 id="lat-heading">Know which millisecond to fix first.</h2>
        <p>The biggest bar is not always the first fix. The skill says which one is.</p>
      </div>
      <LatencyBudget />
    </section>

    <section class="chapter" aria-labelledby="map-heading">
      <div class="head">
        <h2 id="map-heading">One skill for each part of the call.</h2>
        <p>Every skill opens with a <a href="/do-not/">Do not list</a>.</p>
      </div>
      <CallMap client:visible skills={home.skills} />
    </section>

    <section class="chapter split" aria-labelledby="neutral-heading">
      <div class="head">
        <h2 id="neutral-heading">No vendor picks. Pinned adapters.</h2>
        <p><a href="/neutrality/">Neutrality policy</a></p>
      </div>
      <dl class="stamps">
        {
          home.stamps.map((s) => (
            <div>
              <dt>{s.stack}</dt>
              <dd>{s.pin}</dd>
            </div>
          ))
        }
      </dl>
    </section>

    <section class="chapter close" aria-labelledby="close-heading">
      <h2 id="close-heading">Score your agent before your callers do.</h2>
      <CopyCommand client:visible command={install} size="lg" />
      <a class="repo" href={REPO}>MIT licensed, on GitHub <ArrowRight size={16} strokeWidth={1.5} aria-hidden="true" /></a>
    </section>
  </div>
</StarlightPage>

<style>
  .home { color: var(--sl-color-gray-2); }
  .home a { color: var(--sl-color-text-accent); text-underline-offset: 0.2em; }
  .home a:hover { color: var(--sl-color-white); }

  .hero { display: grid; grid-template-columns: minmax(0, 1fr); gap: 2.5rem; padding-block: 2.5rem 4rem; }
  @media (min-width: 64rem) {
    .hero { grid-template-columns: minmax(0, 1.1fr) minmax(0, 1fr); gap: 4rem; align-items: center; padding-block: 4.5rem 6rem; }
  }
  h1 {
    max-width: 14ch;
    margin: 0;
    color: var(--sl-color-white);
    font-size: clamp(2.6rem, 5.6vw, 5rem);
    font-weight: 500;
    line-height: 0.98;
    letter-spacing: -0.045em;
    text-wrap: balance;
  }
  .lede { margin: 1.5rem 0 0; max-width: 30rem; color: var(--sl-color-gray-3); font-size: clamp(1.0625rem, 1.7vw, 1.25rem); line-height: 1.55; }
  .hero-install { max-width: 34rem; margin-top: 2.25rem; }
  .agents { display: flex; flex-wrap: wrap; gap: 0.5rem; margin: 1rem 0 0; padding: 0; list-style: none; }
  .agents li {
    padding: 0.3rem 0.65rem;
    border: 1px solid var(--sl-color-gray-5);
    border-radius: 999px;
    font-size: 0.75rem;
    color: var(--sl-color-gray-3);
  }

  .chapter { border-top: 1px solid var(--sl-color-gray-5); padding-block: 4rem; }
  .head { display: grid; gap: 0.75rem; max-width: 40rem; margin-bottom: 2rem; }
  h2 {
    margin: 0;
    color: var(--sl-color-white);
    font-size: clamp(1.75rem, 3.6vw, 2.75rem);
    font-weight: 500;
    line-height: 1.05;
    letter-spacing: -0.035em;
    text-wrap: balance;
  }
  .head p { margin: 0; color: var(--sl-color-gray-3); line-height: 1.6; }
  @media (min-width: 64rem) {
    .split { display: grid; grid-template-columns: minmax(0, 0.8fr) minmax(0, 1.2fr); gap: 4rem; align-items: center; }
    .split .head { margin-bottom: 0; }
  }

  .stamps { margin: 0; display: grid; }
  .stamps div { display: grid; gap: 0.25rem 1.5rem; padding: 1rem 0; border-top: 1px solid var(--sl-color-gray-5); }
  .stamps div:last-child { border-bottom: 1px solid var(--sl-color-gray-5); }
  @media (min-width: 48rem) { .stamps div { grid-template-columns: 9rem 1fr; } }
  .stamps dt { color: var(--sl-color-white); font-weight: 500; }
  .stamps dd { margin: 0; font-family: var(--__sl-font-mono); font-size: 0.875rem; color: var(--sl-color-gray-2); font-variant-numeric: tabular-nums; }

  .close { display: grid; gap: 1.5rem; max-width: 40rem; padding-bottom: 3rem; }
  .repo { display: inline-flex; align-items: center; gap: 0.4rem; text-decoration: none; }
</style>

<style is:global>
  /* CallMap (React island) */
  .callmap__stages {
    display: grid;
    grid-template-columns: repeat(6, minmax(0, 1fr));
    gap: 0;
    margin-bottom: 1.5rem;
  }
  .callmap__stage {
    position: relative;
    display: grid;
    justify-items: center;
    gap: 0.625rem;
    padding: 0.5rem 0.25rem 0.75rem;
    border: 0;
    background: none;
    color: var(--sl-color-gray-3);
    font: 500 0.8125rem/1.25 var(--__sl-font);
    text-align: center;
    cursor: pointer;
  }
  .callmap__dot {
    position: relative;
    z-index: 1;
    display: grid;
    place-items: center;
    width: 3rem;
    height: 3rem;
    border: 1px solid var(--sl-color-gray-5);
    border-radius: 999px;
    background: var(--sl-color-gray-6);
    color: var(--sl-color-gray-2);
    transition: color 0.2s ease, border-color 0.2s ease, box-shadow 0.3s cubic-bezier(0.16, 1, 0.3, 1), transform 0.3s cubic-bezier(0.16, 1, 0.3, 1);
  }
  .callmap__wire { position: absolute; top: calc(0.5rem + 1.5rem); left: calc(50% + 1.5rem); right: calc(-50% + 1.5rem); height: 1px; background: var(--sl-color-gray-5); }
  .callmap__stage:hover .callmap__dot { color: var(--sl-color-white); border-color: var(--sl-color-gray-4); }
  .callmap__stage[data-state='on'] { color: var(--sl-color-white); }
  .callmap__stage[data-state='on'] .callmap__dot {
    color: var(--sl-color-accent-high);
    border-color: color-mix(in srgb, var(--sl-color-accent-high) 55%, var(--sl-color-gray-5));
    box-shadow: 0 0 0 6px color-mix(in srgb, var(--sl-color-accent-high) 12%, transparent);
    transform: scale(1.06);
  }
  .callmap__stage:focus-visible { outline: none; }
  .callmap__stage:focus-visible .callmap__dot { outline: 2px solid var(--sl-color-accent-high); outline-offset: 3px; }
  .callmap__skills { display: grid; gap: 0.75rem; margin: 0; padding: 0; list-style: none; }
  @media (min-width: 48rem) { .callmap__skills { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  .callmap__skills a {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    gap: 0.375rem 1rem;
    height: 100%;
    padding: 1.25rem;
    border: 1px solid var(--sl-color-gray-5);
    border-radius: 0.875rem;
    background: var(--sl-color-gray-6);
    color: inherit !important;
    text-decoration: none;
    transition: border-color 0.2s ease, transform 0.3s cubic-bezier(0.16, 1, 0.3, 1);
  }
  .callmap__skills a:hover { border-color: var(--sl-color-gray-4); transform: translateY(-2px); }
  .callmap__skills code { font-family: var(--__sl-font-mono); font-size: 0.9375rem; color: var(--sl-color-white); background: none; padding: 0; }
  .callmap__skills span { grid-column: 1; color: var(--sl-color-gray-3); font-size: 0.9375rem; line-height: 1.5; }
  .callmap__go { grid-column: 2; grid-row: 1 / span 2; align-self: center; color: var(--sl-color-gray-4); transition: color 0.2s ease, transform 0.3s cubic-bezier(0.16, 1, 0.3, 1); }
  .callmap__skills a:hover .callmap__go { color: var(--sl-color-accent-high); transform: translateX(3px); }
  @media (max-width: 48rem) {
    .callmap__stages { grid-template-columns: repeat(3, minmax(0, 1fr)); row-gap: 0.75rem; }
    .callmap__wire { display: none; }
  }
</style>
