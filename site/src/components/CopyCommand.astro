---
// One command, one line, one button. The button copies exactly the command, nothing else.
interface Props { command: string; label?: string }
const { command, label = 'Copy command' } = Astro.props;
---

<div class="cmd">
  <code><span class="prompt" aria-hidden="true">$</span>{command}</code>
  <button type="button" data-copy={command} aria-label={label}>
    <svg class="i-copy" viewBox="0 0 24 24" width="16" height="16" aria-hidden="true"><rect x="9" y="9" width="12" height="12" rx="2" /><path d="M5 15V5a2 2 0 0 1 2-2h10" /></svg>
    <svg class="i-done" viewBox="0 0 24 24" width="16" height="16" aria-hidden="true"><path d="M20 6 9 17l-5-5" /></svg>
    <span class="state">Copy</span>
  </button>
</div>

<script>
  document.querySelectorAll<HTMLButtonElement>('.cmd button[data-copy]').forEach((btn) => {
    btn.addEventListener('click', async () => {
      const command = btn.dataset.copy ?? '';
      try {
        await navigator.clipboard.writeText(command);
      } catch {
        return;
      }
      const state = btn.querySelector('.state');
      btn.dataset.done = '';
      if (state) state.textContent = 'Copied';
      setTimeout(() => {
        delete btn.dataset.done;
        if (state) state.textContent = 'Copy';
      }, 1800);
      const ph = (window as unknown as { posthog?: { capture: (e: string, p: object) => void } }).posthog;
      ph?.capture('code_copy', { install: command.startsWith('npx skills add'), command, path: location.pathname });
    });
  });
</script>

<style>
  .cmd {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    min-width: 0;
    border: 1px solid var(--sl-color-gray-5);
    border-radius: 0.5rem;
    background: var(--sl-color-gray-6);
    padding: 0.375rem 0.375rem 0.375rem 1rem;
  }
  code {
    flex: 1;
    min-width: 0;
    white-space: normal;
    overflow-wrap: anywhere;
    line-height: 1.5;
    font-family: var(--__sl-font-mono);
    font-size: 0.875rem;
    color: var(--sl-color-white);
    background: none;
    padding: 0.5rem 0;
    scrollbar-width: thin;
  }
  .prompt { color: var(--sl-color-gray-3); margin-inline-end: 0.75ch; user-select: none; }
  button {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    flex: none;
    min-height: 2.5rem;
    padding: 0 0.875rem;
    border: 1px solid var(--sl-color-gray-5);
    border-radius: 0.375rem;
    background: var(--sl-color-black);
    color: var(--sl-color-gray-2);
    font: 500 0.8125rem/1 var(--__sl-font);
    cursor: pointer;
    transition: color 0.15s ease, border-color 0.15s ease;
  }
  button:hover { color: var(--sl-color-white); border-color: var(--sl-color-gray-4); }
  svg { fill: none; stroke: currentColor; stroke-width: 1.5; stroke-linecap: round; stroke-linejoin: round; }
  .i-done { display: none; }
  button[data-done] { color: var(--sl-color-accent-high); }
  button[data-done] .i-copy { display: none; }
  button[data-done] .i-done { display: block; }
</style>
