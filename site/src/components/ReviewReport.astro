---
// The page's instrument: a trimmed excerpt of a real voice-agent-review run on
// examples/clinic-agent. The excerpt lives in src/data/review-excerpt.json and is copied
// from src/data/clinic-review.md: the scores as reported, the fail and fixes shortened.
// Until an excerpt is committed, the component renders nothing.
interface Excerpt {
  ran: string;
  target: string;
  score: string;
  band?: string;
  groups?: { name: string; score: string }[];
  hardFailures: string[];
  fixes: { fix: string; file: string }[];
}
const found = import.meta.glob<{ default: Excerpt }>('../data/review-excerpt.json', { eager: true });
const r = Object.values(found)[0]?.default;
---

{
  r && (
    <figure class="report" aria-labelledby="report-caption">
      <div class="bar">
        <span class="title">voice-agent-review</span>
        <span class="target">{r.target}</span>
      </div>
      <div class="body">
        <p class="score" style="--i: 0">
          <span class="value">{r.score}</span>
          {r.band && <span class="band">{r.band}</span>}
        </p>
        {r.groups && (
          <ul class="groups" style="--i: 1">
            {r.groups.map((g) => (
              <li>
                <span>{g.name}</span>
                <span class="num">{g.score}</span>
              </li>
            ))}
          </ul>
        )}
        {r.hardFailures.length > 0 && (
          <div class="block" style="--i: 2">
            <p class="label">Hard failures</p>
            <ul class="lines">
              {r.hardFailures.map((h) => (
                <li>{h}</li>
              ))}
            </ul>
          </div>
        )}
        <div class="block" style="--i: 3">
          <p class="label">Fix first</p>
          <ol class="fixes">
            {r.fixes.map((f) => (
              <li>
                <span>{f.fix}</span>
                <code>{f.file}</code>
              </li>
            ))}
          </ol>
        </div>
      </div>
      <figcaption id="report-caption">
        Real output: a <code>voice-agent-review</code> run on the bundled clinic example, {r.ran}.{' '}
        <a href="/example-review/">Read the full report</a>
      </figcaption>
    </figure>
  )
}

<style>
  .report {
    margin: 0;
    min-width: 0;
    border: 1px solid var(--sl-color-gray-5);
    border-radius: 0.75rem;
    background: var(--sl-color-gray-6);
    overflow: hidden;
  }
  .bar {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    padding: 0.75rem 1.25rem;
    border-bottom: 1px solid var(--sl-color-gray-5);
    font-family: var(--__sl-font-mono);
    font-size: 0.75rem;
    color: var(--sl-color-gray-3);
  }
  .title { color: var(--sl-color-white); }
  .target { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .body { display: grid; gap: 1.25rem; padding: 1.25rem; }
  .score { display: flex; align-items: baseline; gap: 0.75rem; margin: 0; }
  .value {
    font-family: var(--__sl-font-mono);
    font-size: clamp(2.25rem, 4vw, 3rem);
    line-height: 1;
    color: var(--sl-color-accent-high);
    font-variant-numeric: tabular-nums;
    letter-spacing: -0.02em;
  }
  .band { color: var(--sl-color-gray-2); font-size: 0.9375rem; }
  .groups {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(11rem, 1fr));
    gap: 0 1.5rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .groups li {
    display: flex;
    justify-content: space-between;
    gap: 0.75rem;
    padding: 0.35rem 0;
    border-bottom: 1px solid var(--sl-color-gray-5);
    font-size: 0.8125rem;
    color: var(--sl-color-gray-3);
  }
  .num { font-family: var(--__sl-font-mono); color: var(--sl-color-white); font-variant-numeric: tabular-nums; }
  .label { margin: 0 0 0.5rem; color: var(--sl-color-white); font-size: 0.875rem; font-weight: 500; }
  .lines, .fixes { margin: 0; padding: 0; list-style: none; display: grid; gap: 0.5rem; }
  .lines li, .fixes li { font-size: 0.875rem; line-height: 1.5; color: var(--sl-color-gray-2); }
  .fixes { counter-reset: fix; }
  .fixes li { display: grid; grid-template-columns: 1.5rem 1fr; gap: 0.15rem 0.25rem; counter-increment: fix; }
  .fixes li::before { content: counter(fix); grid-row: 1 / span 2; font-family: var(--__sl-font-mono); color: var(--sl-color-gray-3); }
  .fixes code, figcaption code { font-family: var(--__sl-font-mono); font-size: 0.75rem; color: var(--sl-color-gray-3); background: none; padding: 0; overflow-wrap: anywhere; }
  figcaption {
    padding: 0.875rem 1.25rem;
    border-top: 1px solid var(--sl-color-gray-5);
    font-size: 0.8125rem;
    line-height: 1.6;
    color: var(--sl-color-gray-3);
  }
  figcaption a { color: var(--sl-color-text-accent); }

  /* The page's one authored motion: the report lays itself down, block by block, the way a
     review lands. Everything is visible by default; motion only runs when the reader allows it. */
  @media (prefers-reduced-motion: no-preference) {
    .body > * {
      animation: land 0.9s cubic-bezier(0.16, 1, 0.3, 1) both;
      animation-delay: calc(0.25s + var(--i, 0) * 0.18s);
    }
    @keyframes land {
      from { opacity: 0; clip-path: inset(0 0 100% 0); transform: translateY(6px); filter: blur(2px); }
      to { opacity: 1; clip-path: inset(0 0 0 0); transform: none; filter: none; }
    }
  }
</style>
