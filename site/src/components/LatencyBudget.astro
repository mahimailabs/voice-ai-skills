---
// The README's example run of the latency calculator (skills/voice-latency-budget), drawn:
//   python scripts/latency_budget.py --shape cascade --eot 700 --ttft 620 --ttfb 240 --e2e 1560
// Limits and the "fix first" verdict are the calculator's own output for those inputs.
const MAX = 1600;
const rows = [
  { stage: 'End of turn', ms: 700, limit: 500, first: true },
  { stage: 'Transcription', ms: null, limit: 200 },
  { stage: 'LLM first token', ms: 620, limit: 400 },
  { stage: 'TTS first byte', ms: 240, limit: 300 },
  { stage: 'End to end', ms: 1560, limit: 800, total: true },
];
const pct = (v: number) => `${(v / MAX) * 100}%`;
---

<figure class="lat" data-lat>
  <ul>
    {
      rows.map((r) => (
        <li data-total={r.total || undefined} data-first={r.first || undefined}>
          <span class="lat__stage">
            {r.stage}
            {r.first && <em>fix first</em>}
          </span>
          <span class="lat__track">
            {r.ms !== null ? (
              <>
                <span class="lat__ok" style={`width:${pct(Math.min(r.ms, r.limit))}`} />
                {r.ms > r.limit && <span class="lat__over" style={`left:${pct(r.limit)};width:${pct(r.ms - r.limit)}`} />}
              </>
            ) : (
              <span class="lat__none">not measured</span>
            )}
            <span class="lat__limit" style={`left:${pct(r.limit)}`} title={`limit ${r.limit} ms`} />
          </span>
          <span class="lat__ms">{r.ms !== null ? `${r.ms}` : '·'}<small>{r.ms !== null ? ' ms' : ''}</small></span>
        </li>
      ))
    }
  </ul>
  <figcaption>
    <span><i class="k k--ok" /> within limit</span>
    <span><i class="k k--over" /> over</span>
    <span><i class="k k--limit" /> limit</span>
    <a href="/skills/voice-latency-budget/">From voice-latency-budget</a>
  </figcaption>
</figure>

<script>
  import { animate, stagger } from 'animejs';
  const root = document.querySelector<HTMLElement>('[data-lat]');
  if (root && !matchMedia('(prefers-reduced-motion: reduce)').matches) {
    const bars = root.querySelectorAll<HTMLElement>('.lat__ok, .lat__over');
    bars.forEach((b) => (b.style.transform = 'scaleX(0)'));
    const io = new IntersectionObserver(
      ([e]) => {
        if (!e.isIntersecting) return;
        io.disconnect();
        animate(root.querySelectorAll('.lat__ok'), { scaleX: [0, 1], duration: 900, ease: 'outExpo', delay: stagger(110) });
        animate(root.querySelectorAll('.lat__over'), { scaleX: [0, 1], duration: 700, ease: 'outExpo', delay: stagger(110, { start: 650 }) });
      },
      { threshold: 0.4 },
    );
    io.observe(root);
  }
</script>

<style>
  .lat { margin: 0; padding: 1.5rem; border: 1px solid var(--sl-color-gray-5); border-radius: 1rem; background: var(--sl-color-gray-6); }
  ul { margin: 0; padding: 0; list-style: none; display: grid; gap: 0.875rem; }
  li { display: grid; grid-template-columns: 9.5rem 1fr 4.5rem; align-items: center; gap: 1rem; }
  li[data-total] { padding-top: 0.875rem; border-top: 1px solid var(--sl-color-gray-5); }
  .lat__stage { font-size: 0.875rem; color: var(--sl-color-gray-2); display: grid; gap: 0.1rem; }
  .lat__stage em { font-style: normal; font-size: 0.75rem; color: var(--sl-color-accent-high); }
  li[data-total] .lat__stage { color: var(--sl-color-white); font-weight: 500; }
  .lat__track { position: relative; height: 0.875rem; border-radius: 4px; background: var(--sl-color-gray-5); }
  .lat__ok, .lat__over { position: absolute; top: 0; bottom: 0; left: 0; transform-origin: left center; }
  .lat__ok { border-radius: 4px 0 0 4px; background: var(--sl-color-accent-high); }
  .lat__over { border-radius: 0 4px 4px 0; background: #fda4af; }
  :root[data-theme='light'] .lat__over { background: #e11d48; }
  :root[data-theme='light'] .lat__ok { background: var(--sl-color-accent); }
  :root[data-theme='light'] .k--over { background: #e11d48; }
  :root[data-theme='light'] .k--ok { background: var(--sl-color-accent); }
  .lat__none { position: absolute; inset: 0; display: grid; place-items: center; font-size: 0.6875rem; color: var(--sl-color-gray-3); background: repeating-linear-gradient(-45deg, transparent 0 5px, color-mix(in srgb, var(--sl-color-gray-3) 22%, transparent) 5px 6px); border-radius: 4px; }
  .lat__limit { position: absolute; top: -0.3rem; bottom: -0.3rem; width: 2px; margin-left: -1px; background: var(--sl-color-white); border-radius: 1px; }
  .lat__ms { font-family: var(--__sl-font-mono); font-size: 0.9375rem; color: var(--sl-color-white); text-align: right; font-variant-numeric: tabular-nums; }
  .lat__ms small { font-size: 0.6875rem; color: var(--sl-color-gray-3); }
  figcaption { display: flex; flex-wrap: wrap; align-items: center; gap: 0.5rem 1.25rem; margin-top: 1.25rem; font-size: 0.8125rem; color: var(--sl-color-gray-3); }
  figcaption a { margin-left: auto; color: var(--sl-color-text-accent); }
  .k { display: inline-block; width: 0.75rem; height: 0.5rem; border-radius: 2px; margin-right: 0.35rem; vertical-align: middle; }
  .k--ok { background: var(--sl-color-accent-high); }
  .k--over { background: #fda4af; }
  .k--limit { width: 2px; height: 0.75rem; background: var(--sl-color-white); }
  @media (max-width: 40rem) {
    .lat { padding: 1rem; }
    li { grid-template-columns: 1fr 4rem; gap: 0.375rem 0.75rem; }
    .lat__stage { grid-column: 1 / -1; }
  }
</style>
