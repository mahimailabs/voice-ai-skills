---
// The clinic case from skills/voice-turn-taking/SKILL.md, drawn to scale: a caller reads a date
// of birth in three groups with 0.6 s between them. Three endpointing policies react. Every time
// on this timeline is the skill's own number; nothing is invented for the drawing.
import { Check, RotateCcw, X } from 'lucide-react';

const T = 4.2; // seconds shown
const pct = (s: number) => `${(s / T) * 100}%`;
const words = [
  { text: 'eleven', from: 0, to: 0.5 },
  { text: 'oh four', from: 1.1, to: 1.6 },
  { text: 'nineteen fifty two', from: 2.2, to: 3.1 },
];
const lanes = [
  { policy: 'Silence timer', value: '0.3 s', at: 0.5 + 0.3, ok: false, outcome: 'Cuts in after “eleven”' },
  { policy: 'Silence timer', value: '0.8 s', at: 3.1 + 0.8, ok: false, outcome: 'Waits, then +0.5 s on every reply' },
  { policy: 'Audio turn detector', value: '0.3–2.5 s', at: 3.1 + 0.3, ok: true, outcome: 'Holds through the gaps' },
];
---

<figure class="pause" data-pause style={`--t: ${T}`}>
  <div class="pause__head">
    <span class="pause__who">Caller</span>
    <div class="pause__track">
      {
        words.map((w) => (
          <span class="word" style={`left:${pct(w.from)};width:${pct(w.to - w.from)}`} data-from={w.from}>
            <span>{w.text}</span>
          </span>
        ))
      }
      {
        [0.5, 1.6].map((g) => (
          <span class="gap" style={`left:${pct(g)};width:${pct(0.6)}`}>0.6 s</span>
        ))
      }
    </div>
  </div>

  {
    lanes.map((l) => (
      <div class="lane" data-ok={l.ok || undefined}>
        <span class="pause__who">
          {l.policy}
          <b>{l.value}</b>
        </span>
        <div class="pause__track">
          <span class="reply" style={`left:${pct(l.at)}`} data-at={l.at}>
            {l.ok ? <Check size={14} strokeWidth={2} aria-hidden="true" /> : <X size={14} strokeWidth={2} aria-hidden="true" />}
          </span>
          <span class="outcome" data-at={l.at} data-side={l.at > T / 2 ? 'left' : 'right'}>
            {l.outcome}
          </span>
        </div>
      </div>
    ))
  }

  <div class="pause__axis" aria-hidden="true">
    <span class="pause__who"></span>
    <div class="pause__track">
      {[0, 1, 2, 3, 4].map((s) => <span class="tick" style={`left:${pct(s)}`}>{s} s</span>)}
    </div>
  </div>
  <div class="pause__overlay" aria-hidden="true"><span class="playhead" data-playhead></span></div>

  <figcaption>
    <a href="/skills/voice-turn-taking/">The clinic case in voice-turn-taking</a>
    <button type="button" data-replay aria-label="Replay the timeline">
      <RotateCcw size={14} strokeWidth={1.75} aria-hidden="true" /> Replay
    </button>
  </figcaption>
</figure>

<script>
  import { createTimeline } from 'animejs';
  const root = document.querySelector<HTMLElement>('[data-pause]');
  if (root) {
    const T = Number(getComputedStyle(root).getPropertyValue('--t')) || 4.2;
    const ms = (s: number) => s * 1000;
    const still = matchMedia('(prefers-reduced-motion: reduce)').matches;
    const words = root.querySelectorAll<HTMLElement>('.word');
    const replies = root.querySelectorAll<HTMLElement>('.reply, .outcome');
    const head = root.querySelector<HTMLElement>('[data-playhead]')!;

    const build = () => {
      const tl = createTimeline({ autoplay: false, defaults: { ease: 'outExpo' } });
      tl.set(words, { opacity: 0.18 }, 0).set(replies, { opacity: 0, scale: 0.6 }, 0).set(head, { left: '0%', opacity: 1 }, 0);
      tl.add(head, { left: '100%', duration: ms(T), ease: 'linear' }, 0);
      words.forEach((w) => tl.add(w, { opacity: [0.18, 1], duration: 260 }, ms(Number(w.dataset.from))));
      replies.forEach((r) => tl.add(r, { opacity: [0, 1], scale: [0.6, 1], duration: 420 }, ms(Number(r.dataset.at))));
      tl.add(head, { opacity: 0, duration: 300 }, ms(T));
      return tl;
    };

    if (!still) {
      let tl = build();
      const io = new IntersectionObserver(
        ([e]) => {
          if (e.isIntersecting) {
            tl.play();
            io.disconnect();
          }
        },
        { threshold: 0.5 },
      );
      io.observe(root);
      root.querySelector('[data-replay]')?.addEventListener('click', () => {
        tl.pause();
        tl = build();
        tl.play();
      });
    } else {
      root.querySelector<HTMLElement>('[data-replay]')!.hidden = true;
    }
  }
</script>

<style>
  .pause {
    margin: 0;
    padding: 1.5rem;
    border: 1px solid var(--sl-color-gray-5);
    border-radius: 1rem;
    background: var(--sl-color-gray-6);
    display: grid;
    gap: 0.25rem;
    overflow: hidden;
  }
  .pause__head, .lane, .pause__axis { display: grid; grid-template-columns: 11rem 1fr; gap: 1rem; align-items: center; }
  .lane { padding-block: 0.625rem; border-top: 1px solid var(--sl-color-gray-5); }
  .pause__head { padding-bottom: 0.75rem; }
  .pause__who { font-size: 0.8125rem; color: var(--sl-color-gray-3); line-height: 1.3; }
  .pause__who b { display: block; font-weight: 500; font-family: var(--__sl-font-mono); color: var(--sl-color-white); }
  .pause__track { position: relative; height: 2.75rem; }
  .pause__head .pause__track { height: 2.5rem; }
  .word {
    position: absolute;
    top: 0.25rem;
    bottom: 0.25rem;
    display: grid;
    place-items: center;
    border-radius: 0.5rem;
    background: color-mix(in srgb, var(--sl-color-white) 10%, transparent);
    border: 1px solid color-mix(in srgb, var(--sl-color-white) 16%, transparent);
    color: var(--sl-color-white);
    font-size: 0.8125rem;
    white-space: nowrap;
    overflow: hidden;
  }
  .word span { padding-inline: 0.4rem; overflow: hidden; text-overflow: ellipsis; }
  .gap {
    position: absolute;
    bottom: -0.1rem;
    translate: 0 100%;
    text-align: center;
    font-family: var(--__sl-font-mono);
    font-size: 0.6875rem;
    color: var(--sl-color-gray-4);
    border-top: 1px dashed var(--sl-color-gray-4);
    padding-top: 0.15rem;
  }
  .reply {
    position: absolute;
    top: 50%;
    translate: -50% -50%;
    display: grid;
    place-items: center;
    width: 1.75rem;
    height: 1.75rem;
    border-radius: 999px;
    color: var(--sl-color-black);
    background: #fda4af;
    box-shadow: 0 0 0 4px color-mix(in srgb, #fda4af 18%, transparent);
  }
  .lane[data-ok] .reply { background: var(--sl-color-accent-high); box-shadow: 0 0 0 4px color-mix(in srgb, var(--sl-color-accent-high) 20%, transparent); }
  .outcome {
    position: absolute;
    top: 50%;
    left: 0;
    translate: 0 -50%;
    font-size: 0.8125rem;
    color: var(--sl-color-gray-2);
    white-space: nowrap;
    transform-origin: left center;
  }
  .lane .outcome { left: auto; right: 0; }
  .lane .outcome[data-side='left'] { left: 0; right: auto; }
  .lane[data-ok] .outcome { color: var(--sl-color-white); }
  .pause__axis .pause__track { height: 1.5rem; border-top: 1px solid var(--sl-color-gray-5); margin-top: 0.5rem; }
  .tick { position: absolute; top: 0.35rem; translate: -50% 0; font-family: var(--__sl-font-mono); font-size: 0.6875rem; color: var(--sl-color-gray-4); }
  .tick:first-child { translate: 0 0; }
  .pause { position: relative; }
  .pause__overlay { position: absolute; top: 1.25rem; bottom: 3.5rem; left: calc(1.5rem + 11rem + 1rem); right: 1.5rem; pointer-events: none; }
  .playhead {
    position: absolute;
    top: 0;
    bottom: 0;
    width: 1px;
    background: linear-gradient(to bottom, transparent, var(--sl-color-accent-high) 15%, var(--sl-color-accent-high) 85%, transparent);
    opacity: 0;
    pointer-events: none;
  }
  figcaption { display: flex; justify-content: space-between; align-items: center; gap: 1rem; margin-top: 0.75rem; font-size: 0.8125rem; }
  figcaption a { color: var(--sl-color-text-accent); }
  figcaption button {
    display: inline-flex; align-items: center; gap: 0.35rem; height: 2rem; padding: 0 0.75rem;
    border: 1px solid var(--sl-color-gray-5); border-radius: 0.5rem; background: var(--sl-color-black);
    color: var(--sl-color-gray-2); font: 500 0.8125rem/1 var(--__sl-font); cursor: pointer;
  }
  figcaption button:hover { color: var(--sl-color-white); border-color: var(--sl-color-gray-4); }
  :root[data-theme='light'] .reply { color: #fff; background: #be123c; box-shadow: 0 0 0 4px rgb(190 18 60 / 0.14); }
  :root[data-theme='light'] .lane[data-ok] .reply { background: var(--sl-color-accent); }

  @media (max-width: 40rem) {
    .pause { padding: 1rem; }
    .pause__head, .lane, .pause__axis { grid-template-columns: 1fr; gap: 0.375rem; }
    .pause__axis .pause__who, .pause__head .pause__who { display: none; }
    .lane .outcome { position: static; translate: none; display: block; margin-top: 2.25rem; white-space: normal; }
    .lane .pause__track { height: auto; min-height: 2.75rem; }
    .reply { top: 1.375rem; }
    .playhead { display: none; }
    .word { font-size: 0.6875rem; }
  }
</style>
